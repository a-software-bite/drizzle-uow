{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "target": "es2021",
    "skipLibCheck": true,
    "strict": true,
    "module": "commonjs",
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["dom", "es2021"],
    "esModuleInterop": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.json", "!./node_modules/**/*.ts"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
